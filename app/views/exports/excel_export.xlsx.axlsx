# app/views/exports/excel_export.xlsx.axlsx

wb = xlsx_package.workbook

wb.add_worksheet(name: "Publications") do |sheet|
  selected_columns = @selected_export_columns.map { |key| @export_columns.fetch(key) }

  sheet.add_row selected_columns.map { |column| column[:label] }

  (@publications_for_export || @publications).each do |pub|
    sheet.add_row selected_columns.map { |column| column[:value].call(pub) }
  end
end
