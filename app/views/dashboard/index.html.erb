<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <header class="mb-4">
    <h1 class="h3 fw-bold mb-1">Publication Statistics Dashboard</h1>
  </header>

  <!-- Stat Cards -->
  <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <div class="col">
      <div class="card border shadow-sm h-100">
        <div class="card-body">
          <div class="text-secondary small mb-1">Total publications</div>
          <div class="fs-3 fw-bold"><%= @dashboard.total_count %></div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card border shadow-sm h-100">
        <div class="card-body">
          <div class="text-secondary small mb-1">Journal articles</div>
          <div class="fs-3 fw-bold"><%= @dashboard.journal_count %></div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card border shadow-sm h-100">
        <div class="card-body">
          <div class="text-secondary small mb-1">Conference-related</div>
          <div class="fs-3 fw-bold"><%= @dashboard.conf_count %></div>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card border shadow-sm h-100">
        <div class="card-body">
          <div class="text-secondary small mb-1">With ≥140 ministerial points</div>
          <div class="fs-3 fw-bold">
            <%= @dashboard.count_140 %>
            <span class="fs-6 fw-normal text-secondary">/ <%= @dashboard.count_with_points %> with points</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Layout: Main Content + Sidebar Filters -->
  <div class="row g-4">
    <!-- Main Content Column -->
    <%= turbo_frame_tag "dashboard_content", class: "col-lg-9 col-md-8" do %>
      <!-- Top Charts -->
      <div class="row row-cols-1 row-cols-lg-2 g-3 mb-4">
        <div class="col">
          <div class="card border shadow-sm h-100">
            <div class="card-body">
              <h6 class="card-title fw-bold mb-3">Publications per year</h6>
              <%= column_chart @dashboard.year_chart_data, stacked: true, height: "300px" %>
            </div>
          </div>
        </div>
        <div class="col">
          <div class="card border shadow-sm h-100">
            <div class="card-body">
              <h6 class="card-title fw-bold mb-3">Publications per research team</h6>
              <%= bar_chart @dashboard.team_chart_data,
                            colors: ["#2a78d6"],
                            height: "300px" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Section: Multiples per team -->
      <div class="mt-4 mb-3">
        <h5 class="fw-bold mb-1">Publications per research team over the years</h5>
        <p class="text-muted small mb-0">One chart per team — respecting current filters.</p>
      </div>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 mb-4">
        <% @dashboard.team_multiples.each do |team| %>
          <div class="col">
            <div class="card border shadow-sm h-100">
              <div class="card-body">
                <h6 class="card-title fw-bold mb-1"><%= team[:name] %></h6>
                <div class="text-muted small mb-2"><%= team[:count] %> publications</div>
                <%= column_chart team[:chart_data],
                                 stacked: true,
                                 legend: false,
                                 height: "180px" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Section: >= 140 pts -->
      <div class="d-flex align-items-center gap-2 mt-4 mb-3">
        <span class="d-inline-block bg-warning rounded-1" style="width: 12px; height: 12px;"></span>
        <h5 class="fw-bold mb-0">Publications with ≥140 ministerial points (MEiN)</h5>
      </div>
      <div class="row row-cols-1 row-cols-lg-2 g-3 mb-4">
        <div class="col">
          <div class="card border shadow-sm h-100">
            <div class="card-body">
              <h6 class="card-title fw-bold mb-3">≥140 points — per year</h6>
              <%= column_chart @dashboard.year_140_chart_data,
                               stacked: true,
                               height: "280px" %>
            </div>
          </div>
        </div>
        <div class="col">
          <div class="card border shadow-sm h-100">
            <div class="card-body">
              <h6 class="card-title fw-bold mb-3">≥140 points — per research team</h6>
              <%= bar_chart @dashboard.team_140_chart_data,
                            colors: ["#eb6834"],
                            height: "280px" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Section: Table -->
      <div class="mt-4 mb-3">
        <h5 class="fw-bold mb-0">Publication list (table view)</h5>
      </div>
      <div class="card border shadow-sm overflow-hidden mb-2">
        <div class="table-responsive" style="max-height: 480px;">
          <table class="table table-hover table-striped align-middle mb-0 small">
            <thead class="table-light sticky-top">
              <tr>
                <th scope="col" style="width: 80px;">Year</th>
                <th scope="col">Title</th>
                <th scope="col">Teams</th>
                <th scope="col">Type</th>
                <th scope="col" style="width: 140px;">Ministerial points</th>
              </tr>
            </thead>
            <tbody>
              <% @dashboard.filtered_publications.sort_by { |p| -(p.publication_year || 0) }.each do |pub| %>
                <tr>
                  <td class="fw-semibold"><%= pub.publication_year || "—" %></td>
                  <td>
                    <%= link_to pub.title,
                                publication_path(pub),
                                class: "text-decoration-none text-dark fw-medium",
                                data: { turbo_frame: "_top" } %>
                  </td>
                  <td class="text-secondary">
                    <% groups = pub.research_groups.map(&:name) %>
                    <%= groups.presence&.map { |g| dashboard_team_short(g) }&.join(", ") || "Unassigned" %>
                  </td>
                  <td><%= pub.category.humanize %></td>
                  <td><%= points_badge(pub.kpi_reporting_extension&.subsidy_points) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="text-muted small">
        Showing <%= @dashboard.filtered_publications.size %> of <%= @dashboard.total_count %> publications
      </div>
    <% end %>

    <!-- Filter Sidebar Column -->
    <div class="col-lg-3 col-md-4">
      <div class="card border shadow-sm sticky-top" style="top: 1rem; z-index: 10;">
        <div class="card-body">
          <h6 class="card-title fw-bold mb-3">Filters</h6>

          <%= search_form_for @q, url: dashboard_path, method: :get,
                              data: {
                                turbo_frame: "dashboard_content",
                                controller: "filter-form",
                                action: "input->filter-form#submit change->filter-form#submit"
                              } do |f| %>

            <!-- Category Checkboxes -->
            <div class="mb-4">
              <div class="text-uppercase text-muted fw-bold small mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                Publication type
              </div>
              <% Publication.categories.keys.each do |key| %>
                <div class="form-check d-flex align-items-center justify-content-between px-0 mb-2">
                  <div class="d-flex align-items-center gap-2">
                    <%= check_box_tag "q[category_in][]", key, @selected_categories.include?(key), id: "type_#{key}", class: "form-check-input m-0" %>
                    <label class="form-check-label small" for="type_<%= key %>">
                      <%= key.humanize %>
                    </label>
                  </div>
                  <span class="badge bg-light text-muted border font-monospace small"><%= @dashboard.global_type_counts[key] %></span>
                </div>
              <% end %>
            </div>

            <!-- Min 140 points toggle -->
            <div class="mb-4">
              <div class="text-uppercase text-muted fw-bold small mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                Ministerial points
              </div>
              <div class="form-check">
                <%= f.check_box :kpi_reporting_extension_subsidy_points_gteq,
                                { checked: params.dig(:q, :kpi_reporting_extension_subsidy_points_gteq) == "140", class: "form-check-input", id: "min_140_check" },
                                "140", "" %>
                <label class="form-check-label small" for="min_140_check">
                  Only publications with ≥140 pts
                </label>
              </div>
            </div>

            <!-- Title Search -->
            <div>
              <div class="text-uppercase text-muted fw-bold small mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                Search
              </div>
              <%= f.search_field :title_cont, class: "form-control form-control-sm", placeholder: "Search by title…" %>
            </div>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
