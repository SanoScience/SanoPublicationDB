<h4>Citations</h4>
    
<% latest_citation = @publication.citation_counts.order(recorded_at: :desc).first %>
<% all_citations = @publication.citation_counts.order(recorded_at: :desc) %>

<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <p class="fs-5 mb-0">
            <span class="badge bg-secondary fs-6 me-2"><%= latest_citation.count %></span>
            <strong>citations</strong> 
            <span class="text-muted fs-6 ms-1">
                (Source: <%= latest_citation.source %>, as of <%= latest_citation.recorded_at.strftime("%b %d, %Y") %>)
            </span>
        </p>

        <% if all_citations.count > 1 %>
            <button class="btn btn-link text-secondary p-0 citation-toggle collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#citationHistory" aria-expanded="false" aria-controls="citationHistory">
                <i class="bi bi-caret-left-fill fs-5 toggle-icon"></i>
            </button>
        <% end %>
    </div>

    <% if all_citations.count > 1 %>
        <div class="collapse mt-3" id="citationHistory">
            
            <div class="d-flex justify-content-center mb-2">
                <ul class="nav nav-pills bg-light rounded p-1 border small" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active py-0 px-2 text-dark" id="list-tab" data-bs-toggle="pill" data-bs-target="#list-view" type="button" role="tab" aria-selected="true">
                            <i class="bi bi-list-ul me-1"></i>List
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-0 px-2 text-dark" id="chart-tab" data-bs-toggle="pill" data-bs-target="#chart-view" type="button" role="tab" aria-selected="false">
                            <i class="bi bi-graph-up me-1"></i>Chart
                        </button>
                    </li>
                </ul>
            </div>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="list-view" role="tabpanel" aria-labelledby="list-tab">
                    <div class="list-group list-group-flush border-top">
                        <% all_citations.limit(16).each do |citation| %>
                            <%= turbo_frame_tag dom_id(citation), class: "list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent" do %>
                                <div>
                                    <span class="fw-semibold me-2"><%= citation.count %></span>
                                    <span class="text-muted small">
                                        <i class="bi bi-clock me-1"></i><%= citation.recorded_at.strftime("%Y-%m-%d %H:%M") %>
                                    </span>
                                </div>
                                
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-light text-dark border"><%= citation.source %></span>
                                    
                                    <% if user_signed_in? && current_user.moderator? %>
                                        <%= button_to citation_count_path(citation),
                                                    method: :delete,
                                                    form: { data: { turbo_confirm: "Delete this record?" } },
                                                    class: "btn btn-sm btn-outline-danger border-0 py-0 px-1" do %>
                                            <i class="bi bi-trash"></i>
                                        <% end %>
                                    <% end %>
                                </div>
                            <% end %>
                        <% end %>

                        <% if all_citations.count > 16 %>
                            <div class="text-center text-muted small mt-2">
                                Showing last 16 records
                            </div>
                        <% end %>
                    </div>
                </div>

                <div class="tab-pane fade" id="chart-view" role="tabpanel" aria-labelledby="chart-tab">
                    <div class="border-top pt-3">
                        <% chart_data = all_citations.reorder(recorded_at: :asc).map { |c| [c.recorded_at.strftime("%y-%m-%d"), c.count] } %>
                        
                        <%= line_chart chart_data, 
                                       discrete: true,
                                       points: true, 
                                       curve: false,
                                       colors: ["#0d6efd"], 
                                       ytitle: "Citations", 
                                       empty: "Not enough data" %>
                    </div>
                </div>
            </div>

        </div>
    <% end %>
</div>

<hr>