<div class="modal fade" id="exportExcelModal" tabindex="-1" aria-labelledby="exportExcelModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exportExcelModalLabel">Export to Excel</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: publications_path(request.query_parameters.except("format", "columns", "commit").merge(format: :xlsx)),
                    method: :get,
                    local: true,
                    data: { turbo: false } do %>
        <%= hidden_field_tag :format, :xlsx %>

        <div class="modal-body">
          <p class="text-muted small mb-3">Select columns to include in the exported file.</p>

          <div class="d-flex flex-column gap-2">
            <% export_columns.each do |key, config| %>
                <div class="form-check">
                    <%= check_box_tag "columns[]",
                                    key,
                                    selected_export_columns.include?(key),
                                    id: "export_column_#{key}",
                                    class: "form-check-input" %>
                    <%= label_tag "export_column_#{key}", config[:label], class: "form-check-label" %>
                </div>
            <% end %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= submit_tag "Export", class: "btn btn-success", data: { bs_dismiss: "modal" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>