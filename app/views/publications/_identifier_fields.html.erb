<div class="nested-fields mb-3">
  <div class="row">
    <div class="col-md-2">
      <%= f.input :category, 
                  collection: Identifier.categories.map { |key, value| [value, key] }, 
                  include_blank: true,
                  input_html: { data: { openalex_autofill_target: "identifierCategory" } } %>
    </div>

    <div class="col-md-10">
      <%= f.input :value, input_html: { data: { openalex_autofill_target: "identifierValue" } } %>
    </div>
  </div>

  <%= link_to_remove_association "Delete", f, class:"btn btn-danger" %>
</div>